# --- ThetaBot secrets (copy to .env; never commit .env) ---
# The bot will REFUSE TO START until these two are set to real values
# (not blank, not the old "change-me-…" placeholders). Supply them as
# environment variables (1Password, Render, etc.) or fill them in here.

# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Protects pause/resume and other control endpoints. Use a long random string.
# Never give this to a monitoring bot — it also derives one-tap approval tokens.
CONTROL_TOKEN=

# Optional. Lets a monitoring bot pause (only) via POST /control/pause-only.
# Must be a different long random string from CONTROL_TOKEN. Cannot resume or approve.
PAUSE_TOKEN=

# --- Optional integrations (leave blank to disable) ---
# Desktop/mobile push alerts (https://pushover.net)
PUSHOVER_TOKEN=
PUSHOVER_USER=
# AI trade-review commentary via Claude (optional; the bot trades fine without it)
ANTHROPIC_API_KEY=

# NOTE: this Robinhood-only edition needs NO market-data keys.
# Robinhood auth is normally data/rh_oauth.json (see README Step 1).
# On Render, paste the one-line JSON from `python -m agentic.tools.rh_login` here:
# RH_OAUTH_JSON=
# Set to 1 only when you must overwrite a broken on-disk token after a new desktop login:
# RH_OAUTH_RESEED=
# Optional: path to the strategy YAML (Render Secret File is /etc/secrets/config.yaml)
# THETABOT_CONFIG=
# Render sets PORT; the app honors it. Local default is 8000.
# PORT=

# Optional: secure public dashboard via Cloudflare Tunnel (no open ports).
# Create a tunnel at dash.cloudflare.com, route it to http://agentic:8000, paste its token here,
# then start with:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
